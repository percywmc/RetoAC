# ---------------------------------------------------------------------------
# Variables de entorno para docker-compose.yml (infraestructura y microservicios)
# Copia este archivo como .env y reemplaza los valores reales.
# NUNCA commitear el archivo .env con credenciales reales.
# ---------------------------------------------------------------------------

# ==============================================================================
# DATOS DEL USUARIO ADMIN (Se sembrará al iniciar la base de datos de Auth)
# ==============================================================================
ADMIN_EMAIL=tu-correo@gmail.com

# SQL Server
SQLSERVER_SA_PASSWORD=CambiarEstaClave#2026

# RabbitMQ
RABBITMQ_USER=atlantic
RABBITMQ_PASSWORD=CambiarEstaClave#2026

# JWT (Microservicio Auth)
JWT_SECRET=CambiarEsteSecretoLargoYSeguro
JWT_ISSUER=AtlanticCity.Auth
JWT_AUDIENCE=AtlanticCity.Clients
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# SMTP (Microservicio Notificaciones)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notificaciones@example.com
SMTP_PASSWORD=CambiarEstaClave#2026
SMTP_FROM_ADDRESS=notificaciones@example.com
SMTP_FROM_NAME=Atlantic City Casino Sports
SMTP_USE_SSL=true

# SeaweedFS
SEAWEEDFS_FILER_URL=http://seaweedfs-filer:8888

# Frontend (build-time — se hornean en el bundle de Vite)
GATEWAY_URL=http://localhost:5000
POLLING_INTERVAL_MS=6000
MAX_FILE_SIZE_MB=10
