{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "cargas-route": {
        "ClusterId": "control-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/v1/cargas/{**catch-all}"
        },
        "AuthorizationPolicy": "RequireAuthenticatedUser"
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "control-cluster": {
        "Destinations": {
          "control-destination": {
            "Address": "http://localhost:5002/"
          }
        }
      }
    }
  }
}
